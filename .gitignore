# ---------------------------------------------------------------
# Enhets-/förbandsspecifikt — distribueras separat, aldrig i git
# ---------------------------------------------------------------
# Serverpaket med TAK-serveradress och certifikat. Varje förband
# lägger in sin egen fil med exakt namnet atak-box.zip.
atak-box.zip

# OpenVPN-klienter
payload/VPN-clients/*
!payload/VPN-clients/.gitkeep

# Certifikat och nycklar
*.p12
*.pfx
*.jks
*.key
*.pem
*.crt
*.cer
*.ovpn

# ---------------------------------------------------------------
# Appar som installeras från Google Play (sidladdas inte längre)
# ---------------------------------------------------------------
payload/apks/ATAK.apk
payload/apks/OpenVPN.apk
payload/apks/Geocam.apk
payload/apks/Signal.apk
payload/apks/Reolink.apk
payload/apks/FileManager.apk

# ---------------------------------------------------------------
# Tredjepartsbinärer — hämtas från leverantören, se README
# ---------------------------------------------------------------
# Android SDK Platform-Tools. Bara det adb behover foljer med (Windows):
# adb.exe + DLL:er, licens och versionsinfo. fastboot, sqlite3, mke2fs
# m.fl. anvands inte av paketet och halls utanfor - fastboot kan dessutom
# radera en telefon om nagon kor fel verktyg.
platform-tools/*
!platform-tools/adb.exe
!platform-tools/AdbWinApi.dll
!platform-tools/AdbWinUsbApi.dll
!platform-tools/source.properties

# ---------------------------------------------------------------
# För stort för git
# ---------------------------------------------------------------
# Originaldokument (.pptx/.docx/.pdf) som konverterats till Markdown
_source/

# ---------------------------------------------------------------
# Loggar och skräp
# ---------------------------------------------------------------
*.log
logs/

# Python
__pycache__/
*.py[cod]
Thumbs.db
desktop.ini
.DS_Store
